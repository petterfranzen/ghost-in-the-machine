/* Motifs.res — the three woven pictures, as 32x20 pixel art.
   '.' is the bare cloth, '1'..'4' are deepening light. */

let width = 32
let height = 20

type palette = {name: string, hint: string, colours: array<string>}

let palettes = [
  {name: "moss", hint: "soft greens, a summer cloth", colours: ["#101a15", "#22382c", "#41654c", "#86b07c", "#eaf4d8"]},
  {name: "dusk", hint: "violet and cold blue", colours: ["#16142a", "#2b2650", "#5d5197", "#ad9ede", "#f6f1ff"]},
  {name: "ember", hint: "warm clay and ash", colours: ["#1c100c", "#3b2113", "#7a4423", "#cf8646", "#ffe0ae"]},
  {name: "moonlight", hint: "silver on water (unlocked)", colours: ["#0d151c", "#1d2f3d", "#3d6c88", "#97c2d8", "#f6fcff"]},
]

