/* --- parsing helpers ------------------------------------------------------ */

let toneOf = c =>
  switch c {
  | "1" => 1
  | "2" => 2
  | "3" => 3
  | "4" => 4
  | _ => 0
  }

let parseRow = row => Belt.Array.makeBy(width, i => toneOf(String.sub(row, i, 1)))

type picture = {name: string, note: string, grid: array<array<int>>}

let pictures: array<picture> = Belt.Array.map(motifs, m =>
  {name: m.name, note: m.note, grid: Belt.Array.map(m.rows, parseRow)}
)
