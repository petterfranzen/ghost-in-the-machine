diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 0573bac..5c11064 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -8,6 +8,12 @@ on:
 permissions:
   contents: read
 
+# Cancel a PR's superseded runs so a stale push cannot hold a runner for the
+# full 360-minute default; never cancel a main run (it may be deploying).
+concurrency:
+  group: ci-${{ github.ref }}
+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
+
 jobs:
   secrets:
     name: Secret scan
